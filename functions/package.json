{
  "name": "officefc-functions",
  "version": "0.1.0",
  "private": true,
  "description": "OfficeFC Cloud Functions — trusted writes (membership, invites; ELO recalc in M2).",
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test:compiled": "node --test test/*.test.js"
  },
  "dependencies": {
    "@sentry/node": "^10.67.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
