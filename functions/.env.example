# OfficeFC Cloud Functions — per-deployment settings.
#
# Copy to `.env.<your-project-id>` (gitignored). firebase-tools loads `.env` and then
# `.env.<projectId>` when you deploy to that project, and on the first deploy it prompts for
# any of the params below that are missing and saves the answers there. The emulators use
# the defaults unless you add a `.env.local`.

# Region for every Cloud Function — pick the one closest to your Firestore database, and set
# the same value as EXPO_PUBLIC_FUNCTIONS_REGION in mobile/.env.
FUNCTIONS_REGION=us-central1

# Comma-separated emails that join as league admins without a join code. The first admin to
# join creates the league, its first season and that season's join code.
ADMIN_EMAILS=

# true = deploy AI photo reading (extractMatchStats) and match analysis (analyzeMatch).
# Also run `npx firebase functions:secrets:set OPENROUTER_API_KEY` and set
# EXPO_PUBLIC_AI_FEATURES=1 in the app.
AI_FEATURES=false

# Sentry DSN for the functions project (a public identifier, not a secret). Leave empty to
# ship with Sentry disabled — module load logs `sentry_disabled`.
SENTRY_DSN=
