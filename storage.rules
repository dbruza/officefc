rules_version = '2';

// OfficeFC — Cloud Storage rules.
//
// Match photos are PRIVATE. Members may upload their own match photos (image, size-
// capped); reads go through short-TTL signed URLs minted by a Cloud Function, so
// direct client reads are denied here. Trusted access uses the Admin SDK.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }
    // Removed members and account-deletion tombstones keep a member doc with a status.
    // One cross-service read; get() on a missing doc errors, which denies.
    function isMember() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/leagues/office/members/$(request.auth.uid))
          .data.get('status', 'active') == 'active';
    }
    // The formats extraction accepts. No SVG or other active content behind a signed URL.
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    function underLimit() {
      return request.resource.size < 12 * 1024 * 1024; // 12 MB
    }

    // match-photos/{uid}/{draftId}/source.{ext}
    match /match-photos/{userId}/{allPaths=**} {
      allow read: if false; // served via signed URLs only
      // New objects only: every upload gets a fresh draft path, and a photo already
      // attached to a match must not be swapped afterwards. (Re-uploading over an existing
      // object is evaluated as `create`, hence the `resource == null`.)
      allow create: if isMember() && userId == request.auth.uid && resource == null
        && isImage() && underLimit();
      allow update: if false;
      allow delete: if isMember() && userId == request.auth.uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
