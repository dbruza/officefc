# Dependencies (matches node_modules at any depth: root + mobile/ + functions/)
node_modules

# Build outputs
dist/
web-build/
functions/lib/
# Generated by `npm run build` from prototype/officefc/
OfficeFC.html
# Stale prototype archive (source lives unpacked in prototype/officefc/)
OfficeFc.zip

# Expo / React Native
.expo/
*.orig.*
# Generated native projects (expo prebuild / EAS)
mobile/ios/
mobile/android/

# Env & secrets (keep .env.example tracked)
.env
.env.local
.env.*.local
# Per-project Cloud Functions params (functions/.env.<projectId>) and emulator secrets
functions/.env.*
!functions/.env.example
!functions/.env.demo-officefc
functions/.secret.local

# The selected Firebase project is per-deployment: run `npx firebase use --add`
.firebaserc

# Logs & OS cruft
*.log
.DS_Store
.firebase/

# Claude: share launch.json, keep local settings out
.claude/settings.local.json

.claude/worktrees/
