{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "officefc-static",
      "runtimeExecutable": "node",
      "runtimeArgs": ["build/serve.js"],
      "port": 8756
    },
    {
      "name": "officefc-mobile-web",
      "runtimeExecutable": "node",
      "runtimeArgs": ["mobile/serve-web.js"],
      "port": 8757
    },
    {
      "name": "expo-web-emulators",
      "runtimeExecutable": "env",
      "runtimeArgs": ["EXPO_PUBLIC_USE_EMULATORS=1", "npm", "--prefix", "mobile", "run", "web"],
      "port": 8081
    }
  ]
}
