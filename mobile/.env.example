# OfficeFC mobile — public Firebase web config (NOT secret; access is governed by
# Firestore/Storage security rules). Copy to `.env` and paste the EXACT values from
# Firebase console → Project settings → "Your apps" → Web app → "SDK setup and config".
#
# Don't hand-type the domains: newer projects use *.firebasestorage.app for the storage
# bucket (older ones used *.appspot.com) — copy whatever the console actually shows.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Set to 1 to use the local Firebase Emulator Suite during development.
EXPO_PUBLIC_USE_EMULATORS=1

# Forward client warn/error logs to the authenticated ingestLog sink (Cloud Logging).
EXPO_PUBLIC_REMOTE_LOGGING=0

# Sentry crash/error reporting (officefc-mobile project DSN — public identifier, not a
# secret). Leave empty to disable; also disabled automatically in dev builds. Native
# builds get these from eas.json; this file feeds local dev and the web deploy.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENV=development
