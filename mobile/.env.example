# OfficeFC mobile — public Firebase web config (NOT secret; access is governed by
# Firestore/Storage security rules). Copy to `.env` and fill from your Firebase
# project settings → "Your apps" → Web app config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=officefc-dev.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=officefc-dev
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=officefc-dev.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Set to 1 to use the local Firebase Emulator Suite during development.
EXPO_PUBLIC_USE_EMULATORS=1
