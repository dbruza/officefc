# OfficeFC app configuration. Copy to `.env` (gitignored). Native EAS builds don't read this
# file: set the same variables as EAS environment variables instead.
#
# As shipped, this file runs the app against the local Firebase Emulator Suite with the
# `demo-officefc` project (`npx firebase emulators:start --project demo-officefc`), so it
# works without a Firebase project. For a real deployment, replace the six FIREBASE values
# with the EXACT ones from Firebase console → Project settings → "Your apps" → Web app →
# "SDK setup and config", and set EXPO_PUBLIC_USE_EMULATORS=0. They're public client
# metadata, not secrets: access is governed by the Firestore/Storage security rules.
#
# Don't hand-type the domains: newer projects use *.firebasestorage.app for the storage
# bucket (older ones used *.appspot.com) — copy whatever the console actually shows.
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-officefc.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-officefc
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-officefc.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo

# 1 = use the local Firebase Emulator Suite. Must be 0 for a production build.
EXPO_PUBLIC_USE_EMULATORS=1

# Region your Cloud Functions run in. Must equal FUNCTIONS_REGION in
# functions/.env.<projectId> (both default to us-central1).
EXPO_PUBLIC_FUNCTIONS_REGION=us-central1

# 1 = offer AI photo logging and match analysis. Needs AI_FEATURES=true for the functions
# and the OPENROUTER_API_KEY secret; leave 0 to log matches manually only.
EXPO_PUBLIC_AI_FEATURES=0

# Shown on /privacy, /terms and /support. Who runs this deployment ("OfficeFC is an
# independent app run by …"), a contact address, and where Firestore keeps league data
# (e.g. "Sydney, Australia"). Review mobile/src/lib/legal.ts before going live.
EXPO_PUBLIC_OPERATOR_NAME=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_DATA_LOCATION=

# Public web address, used for invite links shared from the native apps. Defaults to
# https://<project id>.web.app.
EXPO_PUBLIC_WEB_URL=

# Forward client warn/error logs to the authenticated ingestLog sink (Cloud Logging).
EXPO_PUBLIC_REMOTE_LOGGING=0

# Sentry crash/error reporting (a project DSN — a public identifier, not a secret). Leave
# empty to disable; also disabled automatically in dev builds.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENV=development
