rules_version = '2';

// OfficeFC — Firestore security rules.
//
// Model: a single office league ("office" in v1). Clients READ league data directly
// when they are members; all TRUSTED writes (ELO, standings, match status, season
// results, invite consumption) go through Cloud Functions via the Admin SDK, which
// bypasses these rules. So most collections are read-for-members / write-denied here.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    // Single-league v1: membership doc at leagues/office/members/{uid}. Removed members
    // and account-deletion tombstones keep their doc (history still resolves) but carry a
    // status, and have no access.
    function memberPath(userId) {
      return /databases/$(database)/documents/leagues/office/members/$(userId);
    }
    function isActiveMember(userId) {
      return exists(memberPath(userId))
        && get(memberPath(userId)).data.get('status', 'active') == 'active';
    }
    function isMember() {
      return signedIn() && isActiveMember(uid());
    }
    function memberRole() {
      return get(/databases/$(database)/documents/leagues/office/members/$(uid())).data.role;
    }
    function isAdmin() {
      return isMember() && memberRole() == 'admin';
    }
    // One document read instead of exists() + get(): for match creation, which is close to
    // the 10-read budget per request. get() on a missing doc errors, which denies.
    // Blocks aren't checked here for the same reason — notifyMatchSubmitted voids a
    // match between a blocked pair.
    function isLeagueMember(userId) {
      return get(memberPath(userId)).data.get('status', 'active') == 'active';
    }
    // Mirrors the app's checks (ProfileForm + models/safety.ts). The offensive-word screen
    // runs in the screenProfileName function, which rules can't express.
    function validProfileName(data) {
      return data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 40
        && data.handle is string
        && data.handle.matches('^[a-z0-9_]{2,20}$');
    }
    function isActiveSeason(seasonId) {
      return exists(/databases/$(database)/documents/seasons/$(seasonId))
        && get(/databases/$(database)/documents/seasons/$(seasonId)).data.active == true;
    }
    function isNamedTeam(teamId, teamName) {
      return exists(/databases/$(database)/documents/teams/$(teamId))
        && get(/databases/$(database)/documents/teams/$(teamId)).data.name == teamName;
    }
    // Free-choice (manual) matches must use a team still in the picker. Fixture and finals
    // submissions only need isNamedTeam: they must mirror the teams the engine dealt, so a
    // catalogue sync that retires those teams mid-matchup doesn't strand the tie.
    function isValidTeam(teamId, teamName) {
      return isNamedTeam(teamId, teamName)
        && get(/databases/$(database)/documents/teams/$(teamId)).data.active == true;
    }
    function fixtureData(fixtureId) {
      return get(/databases/$(database)/documents/fixtures/$(fixtureId)).data;
    }
    // An auto-matchup submission must mirror its fixture exactly: same season, same
    // players on the same sides, and the teams the engine dealt. Status 'proposed'
    // stops a fixture from being recorded twice.
    function honorsFixture(data) {
      return fixtureData(data.fixtureId).seasonId == data.seasonId
        && fixtureData(data.fixtureId).status == 'proposed'
        && fixtureData(data.fixtureId).aId == data.aId
        && fixtureData(data.fixtureId).bId == data.bId
        && fixtureData(data.fixtureId).aTeamId == data.aTeamId
        && fixtureData(data.fixtureId).bTeamId == data.bTeamId;
    }
    function finalsSlotData(data) {
      return get(/databases/$(database)/documents/seasons/$(data.seasonId)/finals/bracket)
        .data.slots[data.finalsSlot];
    }

    // Prediction game: a picks doc may only contain picks for bracket slots that are
    // still open (participants known, tie undecided), and each pick must name one of
    // that slot's two participants. Once a tie is decided its slot closes — the stored
    // pick is frozen forever after, so every scored pick was provably written before
    // the result existed. This replaces any timestamp-based late-edit check.
    // KNOWN WINDOW (accepted v1): a match sits readable in pending_confirmation between
    // being played/submitted and confirmation, so someone who can see the scoreline could
    // pre-pick the winner before the bracket closes the slot. Office stakes; accepted.
    function finalsBracketSlot(seasonId, key) {
      return get(/databases/$(database)/documents/seasons/$(seasonId)/finals/bracket)
        .data.slots[key];
    }
    function pickIsForOpenSlot(pick, seasonId, key) {
      let slot = finalsBracketSlot(seasonId, key);
      return slot.status == 'open'
        && pick.keys().hasOnly(['predictedWinnerId'])
        && pick.predictedWinnerId is string
        && (slot.homeId == pick.predictedWinnerId || slot.awayId == pick.predictedWinnerId);
    }
    function picksAreForOpenSlots(data, seasonId) {
      return data.picks.keys().hasOnly(['e1', 'e2', 's1', 's2', 'gf'])
        && data.picks.keys().size() > 0
        && (!('e1' in data.picks) || pickIsForOpenSlot(data.picks.e1, seasonId, 'e1'))
        && (!('e2' in data.picks) || pickIsForOpenSlot(data.picks.e2, seasonId, 'e2'))
        && (!('s1' in data.picks) || pickIsForOpenSlot(data.picks.s1, seasonId, 's1'))
        && (!('s2' in data.picks) || pickIsForOpenSlot(data.picks.s2, seasonId, 's2'))
        && (!('gf' in data.picks) || pickIsForOpenSlot(data.picks.gf, seasonId, 'gf'));
    }
    // A finals submission must mirror the open bracket tie exactly: the two players on
    // their bracket sides with the equal teams the engine dealt. 'open' blocks double
    // recording, and a level score is rejected outright — extra time and penalties
    // always produce a winner on the console.
    function honorsFinalsSlot(data) {
      return finalsSlotData(data).status == 'open'
        && finalsSlotData(data).homeId == data.aId
        && finalsSlotData(data).awayId == data.bId
        && finalsSlotData(data).homeTeamId == data.aTeamId
        && finalsSlotData(data).awayTeamId == data.bTeamId
        && data.aGoals != data.bGoals
        && (!('decidedBy' in data)
            || data.decidedBy in ['regulation', 'extra_time', 'penalties']);
    }

    // Profiles: any member can read; you can always read your OWN profile (needed during
    // onboarding, before membership). You may write only your own name, handle, jersey and
    // colour (role is authoritative on the membership doc). Admins may write any.
    match /profiles/{userId} {
      allow read: if isMember() || (signedIn() && userId == uid());
      allow create: if isAdmin()
        || (signedIn() && userId == uid()
          && request.resource.data.keys().hasOnly(['displayName', 'handle', 'jersey', 'color', 'updatedAt'])
          && validProfileName(request.resource.data));
      allow update: if isAdmin()
        || (signedIn() && userId == uid()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'handle', 'jersey', 'color', 'updatedAt'])
          && validProfileName(request.resource.data));
      allow delete: if isAdmin();
    }

    // League + membership: members read; membership is granted by a Cloud Function
    // (invite redemption) or an admin — not by arbitrary client writes.
    match /leagues/{leagueId} {
      allow read: if isMember();
      allow write: if false; // function/admin-only
      match /members/{memberId} {
        // Members see the roster; you can always read your OWN membership doc (so the app
        // can tell whether you've joined yet). Writes are function/admin-only.
        allow read: if isMember() || (signedIn() && memberId == uid());
        allow write: if false;
      }
    }

    // Invites are validated/consumed server-side; never exposed to clients.
    match /invites/{code} {
      allow read, write: if false;
    }

    // Admin-curated reference data: members read, admins (via console/functions) write.
    match /seasons/{seasonId} {
      allow read: if isMember();
      allow write: if false;
      match /{sub=**} {
        allow read: if isMember();   // standings, snapshots, eloHistory
        allow write: if false;       // function-only
      }
    }

    // Season join codes: function-only, never exposed to clients. The season doc above is
    // member-readable, so codes must NOT live on it (members would harvest them). Admins read
    // codes through the getSeasonJoinCode callable; redemption is validated server-side.
    match /seasonCodes/{seasonId} {
      allow read, write: if false;
    }
    match /teams/{teamId} {
      allow read: if isMember();
      allow write: if false;
    }

    // Auto-matchup fixtures: dealt by the createFixture callable, consumed by a trigger
    // when the referencing match lands. Members read (to see their dealt teams).
    match /fixtures/{fixtureId} {
      allow read: if isMember();
      allow write: if false;
    }
    match /teamCatalogues/{catalogueId} {
      allow read: if isMember();
      allow write: if false;
    }

    // Matches: members read. A member may CREATE a pending match they participate in;
    // all status/ELO mutations happen in Cloud Functions (confirm/recalc/dispute).
    match /matchAnalysis/{matchId} {
      allow read: if isMember();
      allow write: if false;
    }
    match /seasonSummaries/{seasonId} {
      allow read: if isMember();
      allow write: if false;
    }
    match /readModelQueue/{leagueId} {
      allow read: if leagueId == "office" && isMember();
      allow write: if false;
    }
    match /matches/{matchId} {
      allow read: if isMember();
      allow create: if signedIn()
        && isLeagueMember(uid())
        && request.resource.data.keys().hasAll([
          'seasonId', 'submittedBy', 'aId', 'bId', 'aTeamId', 'bTeamId',
          'aTeam', 'bTeam', 'aGoals', 'bGoals', 'status', 'source', 'date', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'seasonId', 'submittedBy', 'aId', 'bId', 'aTeamId', 'bTeamId',
          'aTeam', 'bTeam', 'aGoals', 'bGoals', 'status', 'source', 'date', 'createdAt',
          'fixtureId', 'finals', 'finalsSlot', 'decidedBy'
        ])
        && request.resource.data.submittedBy == uid()
        && (request.resource.data.aId == uid() || request.resource.data.bId == uid())
        && request.resource.data.aId != request.resource.data.bId
        && isLeagueMember(request.resource.data.aId)
        && isLeagueMember(request.resource.data.bId)
        && isActiveSeason(request.resource.data.seasonId)
        && isNamedTeam(request.resource.data.aTeamId, request.resource.data.aTeam)
        && isNamedTeam(request.resource.data.bTeamId, request.resource.data.bTeam)
        && request.resource.data.aGoals is int
        && request.resource.data.bGoals is int
        && request.resource.data.aGoals >= 0
        && request.resource.data.aGoals <= 99
        && request.resource.data.bGoals >= 0
        && request.resource.data.bGoals <= 99
        && request.resource.data.status == 'pending_confirmation'
        && (
          (request.resource.data.source == 'manual'
            && !('fixtureId' in request.resource.data)
            && !('finals' in request.resource.data)
            && !('finalsSlot' in request.resource.data)
            && !('decidedBy' in request.resource.data)
            && isValidTeam(request.resource.data.aTeamId, request.resource.data.aTeam)
            && isValidTeam(request.resource.data.bTeamId, request.resource.data.bTeam))
          || (request.resource.data.source == 'fixture'
            && 'fixtureId' in request.resource.data
            && request.resource.data.fixtureId is string
            && !('finals' in request.resource.data)
            && !('finalsSlot' in request.resource.data)
            && !('decidedBy' in request.resource.data)
            && honorsFixture(request.resource.data))
          || (request.resource.data.source == 'finals'
            && !('fixtureId' in request.resource.data)
            && request.resource.data.finals == true
            && request.resource.data.finalsSlot is string
            && honorsFinalsSlot(request.resource.data))
        )
        && request.resource.data.date == request.time
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false; // function/admin-only
      match /{sub=**} {
        allow read: if isMember();
        allow write: if false;
      }
    }

    // Read-optimized aggregates, all maintained by functions.
    match /playerStats/{userId} {
      allow read: if isMember();
      allow write: if false;
    }
    match /h2h/{pairKey} {
      allow read: if isMember();
      allow write: if false;
    }

    // League activity feed: members read; events are written only by Cloud Functions.
    match /activity/{eventId} {
      allow read: if isMember();
      allow write: if false;
    }
    match /seasonResults/{seasonId} {
      allow read: if isMember();
      allow write: if false;
      match /{sub=**} {
        allow read: if isMember();
        allow write: if false;
      }
    }

    // Finals predictions (prediction game): members read all; each member writes only
    // their own prediction doc. Every pick must name an OPEN bracket slot at write time —
    // once a tie is decided its slot closes and the stored pick is frozen, which is what
    // makes every scored pick provably pre-decision (no timestamp comparison needed).
    // predictorId is pinned to the caller so a member cannot forge another member's entry,
    // and updatedAt must equal request.time so the stamp is server-written.
    match /finalsPredictions/{seasonId}/picks/{predictorId} {
      allow read: if isMember();
      allow create: if signedIn() && predictorId == uid()
        && request.resource.data.predictorId == uid()
        && request.resource.data.updatedAt == request.time
        && picksAreForOpenSlots(request.resource.data, seasonId);
      allow update: if signedIn() && predictorId == uid()
        && request.resource.data.predictorId == resource.data.predictorId
        && request.resource.data.updatedAt == request.time
        && picksAreForOpenSlots(request.resource.data, seasonId);
      allow delete: if false;
    }
    // Prediction-game scoreboard is function-written.
    match /finalsPredictions/{seasonId}/scoreboard/{docId} {
      allow read: if isMember();
      allow write: if false;
    }

    // Per-match MVP peer votes: members read; the castVote Cloud Function is the ONLY
    // writer (it enforces window/participant/finals/candidate checks that rules cannot
    // express). Client-side writes are denied outright — tallies stay unforgable.
    match /matchVotes/{matchId}/votes/{docId} {
      allow read: if isMember();
      allow write: if false;
    }

    // Push tokens: a user manages only their own.
    match /deviceTokens/{userId}/tokens/{tokenId} {
      allow read, write: if signedIn() && userId == uid();
    }

    // Notification preferences: a user manages only their own prefs doc
    // (muted categories map). Functions read it when delivering pushes.
    match /pushPrefs/{userId} {
      allow read: if signedIn() && userId == uid();
      allow write: if signedIn() && userId == uid()
        && request.resource.data.keys().hasOnly(['muted', 'updatedAt']);
    }

    // Privacy choices (AI photo reading consent, terms acceptance): owner-only. Functions
    // read aiPhotoReading before sending a photo to the AI model.
    match /privacySettings/{userId} {
      allow read: if signedIn() && userId == uid();
      allow create, update: if signedIn() && userId == uid()
        && request.resource.data.keys()
          .hasOnly(['aiPhotoReading', 'aiPhotoReadingUpdatedAt', 'termsAcceptedAt'])
        && (!('aiPhotoReading' in request.resource.data)
          || request.resource.data.aiPhotoReading is bool);
    }

    // Your block list: you can read it; only the setPlayerBlocked function writes it.
    match /userBlocks/{userId} {
      allow read: if signedIn() && userId == uid();
      allow write: if false;
    }

    // Player reports: admins review them; only reportPlayer/setPlayerBlocked write them.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
